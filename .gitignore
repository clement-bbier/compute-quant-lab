# Secrets — NEVER committed
.env
.claude/settings.local.json
**/.credentials.json

# Claude Code worktrees (local checkouts, never committed; cf. docs/git-workflow.md §8)
.claude/worktrees/

# Derived layers: regenerable from data/snapshots/, never committed.
/data/raw/*
/data/interim/*
/data/processed/*
/data/cold/*
!/data/**/.gitkeep
# Exception: data/cold/energy/ (ENTSO-E FR/DE day-ahead prices) IS committed (V5.3) — the
# zero-key real-data path for P02/P05, backfilled once via infra/collectors/entsoe_backfill.py.
!/data/cold/energy/
!/data/cold/energy/**

# data/snapshots/ IS versioned: it's the raw data collected hour by hour,
# irreplaceable (the price of compute has no purchasable history).
# Both CSV and Parquet are plain git (LFS removed).

# Experiments / artifacts
/experiments/mlruns/
**/results/*.png
**/results/*.parquet

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Rust (maturin/cargo build output for the _loop, _kernel, forward_engine crates)
target/
*.pyd
*.so

# Coverage (make coverage) — regenerated locally/CI, never committed.
.coverage
.coverage-report.md
coverage.xml
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Scheduled collector logs (runtime, never committed)
infra/collectors/*.log

# Private / edge strategies — NEVER versioned (the repo is PUBLIC).
# Anything that makes money lives here and never goes online.
/private/*
!/private/README.md
!/private/.gitkeep
*.private.py
*.private.json
*.private.parquet
