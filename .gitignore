# Secrets — JAMAIS committés
.env
.claude/settings.local.json
**/.credentials.json

# Worktrees Claude Code (checkouts locaux, jamais committés ; cf. docs/git-workflow.md §8)
.claude/worktrees/

# Couches dérivées : régénérables depuis data/snapshots/, jamais committées.
/data/raw/*
/data/interim/*
/data/processed/*
/data/cold/*
!/data/**/.gitkeep

# data/snapshots/ EST versionné : c'est la donnée brute collectée heure par
# heure, irremplaçable (le prix du compute n'a pas d'historique achetable).
# Les CSV passent par git-lfs (cf. .gitattributes) ; les Parquet, petits et
# nombreux, restent en git ordinaire — LFS y serait contre-productif.

# Expériences / artefacts
/experiments/mlruns/
**/results/*.png
**/results/*.parquet

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Notebooks
.ipynb_checkpoints/

# Logs du collecteur planifié (runtime, jamais committés)
infra/collectors/*.log

# Stratégies privées / à edge — JAMAIS versionnées (le repo est PUBLIC).
# Tout ce qui génère de l'argent vit ici et ne part jamais en ligne.
/private/*
!/private/README.md
!/private/.gitkeep
*.private.py
*.private.json
*.private.parquet
