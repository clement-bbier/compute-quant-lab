# Copy to .env at the repo root. Never commit.

# ── Energy ──────────────────────────────────────────────────────────────────
ENTSOE_API_TOKEN=
# ERCOT (Texas) via the GridStatus.io hosted API — bypasses the Imperva WAF
# geoblock (ercot.com blocks non-US IPs). Free key: https://www.gridstatus.io .
# Key-gated: an empty slot skips the hosted egress (falls back to the direct
# transport, which is geoblocked outside the US).
GRIDSTATUS_API_KEY=

# ── GPU marketplaces (active connectors) ─────────────────────────────────────
# One connector per venue in core/ingestion/providers/<venue>.py. Key-gated:
# an empty slot is skipped (a warning is logged), never a hard failure.
VASTAI_API_KEY=
RUNPOD_API_KEY=
PRIMEINTELLECT_API_KEY=
# DataCrunch (rebranded "Verda"): OAuth2 client credentials.
DATACRUNCH_CLIENT_ID=
DATACRUNCH_CLIENT_SECRET=
CUDO_API_KEY=
HYPERSTACK_API_KEY=
# TensorDock: Bearer token. Dormant venue: live hostnode inventory has been empty on
# every check (2026-06-23 and the V5.2 live campaign) -- not a connector failure, there's
# simply nothing listed. Verdict on the second credential (V5.2): the connector only ever
# sends TENSORDOCK_API_KEY as the Bearer token; a TENSORDOCK_API_AUTHORIZATION slot is not
# read anywhere in the codebase, so it has been removed from this file.
TENSORDOCK_API_KEY=

# ── Reserved: connectors not implemented yet, leave empty ───────────────────
LAMBDA_API_KEY=
CRUSOE_ACCESS_KEY_ID=
CRUSOE_SECRET_KEY=
GENESISCLOUD_API_KEY=
# Canonical compute spot index (Silicon Data, SDH100RT). SiliconDataSource.fetch()
# raises NotImplementedError until this is wired in (core/ingestion/compute_index.py).
SILICONDATA_API_TOKEN=
